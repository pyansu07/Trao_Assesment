# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB connection string. Local dev default works with `docker compose up -d`
# from the repo root (see docker-compose.yml). Tests use an in-memory Mongo
# instance (mongodb-memory-server) and do not need this at all.
MONGODB_URI=mongodb://127.0.0.1:27017/interview_prep_kit

# Secret used to sign session JWTs stored in an httpOnly cookie. Use a long
# random string in any real deployment.
SESSION_SECRET=change-this-to-a-long-random-string

# Google Gemini API key (genuine free tier). Get one at https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest

# Optional: a paid search provider key (Serper/Bing/etc). Not required - the
# public interview-discussion search defaults to DuckDuckGo's keyless HTML
# search endpoint, which needs no API key.
SEARCH_API_KEY=

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# "evaluation": allows retrieval of localhost/private-network URLs. Required
#   for the batch evaluator's local fixture company sites, and convenient for
#   local dev/tests.
# "production": rejects localhost/private/loopback targets outright (SSRF
#   hardening) and re-validates every resolved DNS answer.
# If unset, defaults to "production" when NODE_ENV=production and
# "evaluation" otherwise.
RETRIEVAL_ENV=evaluation
